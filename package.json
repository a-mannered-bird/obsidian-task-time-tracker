{
	"name": "obsidian-task-time-tracker",
	"version": "0.0.1",
	"description": "An obsidian plugin for effortlessly tracking your tasks and built helpful stats out of it.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"lint": "eslint .",
		"svelte-check": "svelte-check --tsconfig tsconfig.json",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"esbuild-svelte": "^0.9.4",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"prettier": "3.7.4",
		"svelte": "^5.46.0",
		"svelte-check": "^4.3.5",
		"svelte-preprocess": "^6.0.3",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
