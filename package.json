{
	"name": "obsidian-task-time-tracker",
	"version": "0.0.1",
	"description": "Track the time you spend on your tasks in your daily notes and build statistics out of it.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"deploy": "npm run build && node deploy.mjs",
		"dev": "node esbuild.config.mjs",
		"lint": "eslint .",
		"svelte-check": "svelte-check --tsconfig tsconfig.json",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "npm run build && npm run typecheck:e2e && wdio run ./wdio.conf.mts",
		"typecheck:e2e": "tsc -p test --noEmit",
		"test:e2e:debug": "npm run build && npm run typecheck:e2e && wdio run ./wdio.debug.conf.mts",
		"test:e2e:trace": "npm run build && npm run typecheck:e2e && WDIO_DEVTOOLS_MODE=trace wdio run ./wdio.debug.conf.mts",
		"test:e2e:trace:open": "show-trace \"$(ls -t test-results/trace-*.zip | head -1)\""
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.20.1",
		"@wdio/cli": "^9.31.5",
		"@wdio/devtools-service": "^10.9.1",
		"@wdio/local-runner": "^9.31.5",
		"@wdio/mocha-framework": "^9.31.5",
		"esbuild": "0.25.5",
		"esbuild-svelte": "^0.9.4",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"mocha": "^12.0.0",
		"prettier": "3.7.4",
		"svelte": "^5.46.0",
		"svelte-check": "^4.3.5",
		"svelte-preprocess": "^6.0.3",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vite": "^7.3.6",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^3.2.7",
		"wdio-obsidian-reporter": "^3.2.0",
		"wdio-obsidian-service": "^3.2.0"
	},
	"dependencies": {
		"obsidian": "latest",
		"prettier-plugin-svelte": "^3.4.1"
	}
}
